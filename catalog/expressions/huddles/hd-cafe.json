    {"id":"hd-cafe.011","spots":["coffee_bar"],"topics":["office"],"roles":{"A":{"archetypes":["playful","warm"]},"B":{"archetypes":["dry-wit","analytical"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
