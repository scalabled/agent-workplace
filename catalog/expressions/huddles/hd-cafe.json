    {"id":"hd-cafe.010","spots":["coffee_bar"],"topics":["office"],"roles":{"A":{"archetypes":["dry-wit","calm-steady"]},"B":{"archetypes":["warm","gentle"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"I'm here for the ambience, not the beans."},
