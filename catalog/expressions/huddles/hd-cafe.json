    {"id":"hd-cafe.007","spots":["coffee_bar"],"topics":["office"],"roles":{"A":{"archetypes":["energetic","playful"]},"B":{"archetypes":["meticulous","dry-wit"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
