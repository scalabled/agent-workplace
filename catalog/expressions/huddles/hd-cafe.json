    {"id":"hd-cafe.006","spots":["coffee_bar"],"topics":["office"],"roles":{"A":{"archetypes":["visionary","playful"]},"B":{"archetypes":["dry-wit","calm-steady"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"The pendant lights make the island feel like a stage."},
