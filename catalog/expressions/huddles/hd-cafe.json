    {"id":"hd-cafe.021","spots":["coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["energetic","playful"]},"B":{"archetypes":["calm-steady","dry-wit"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Do you ever order in your head?"},
      {"role":"B","text":"Every time. Large, oat, no regrets."},
