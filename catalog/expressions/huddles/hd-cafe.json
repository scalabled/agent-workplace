    {"id":"hd-cafe.024","spots":["coffee_bar"],"topics":["office"],"roles":{"A":{"archetypes":["dry-wit","veteran"]},"B":{"archetypes":["playful","energetic"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
