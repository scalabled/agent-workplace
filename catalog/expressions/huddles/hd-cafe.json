    {"id":"hd-cafe.055","spots":["coffee_bar"],"topics":["ideas"],"roles":{"A":{"archetypes":["playful","energetic"]},"B":{"archetypes":["meticulous","gentle"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if a whole wall was sticky notes?"},
      {"role":"B","text":"It'd be the most honest wall here."}
    ]},
    {"id":"hd-cafe.056","spots":["coffee_bar"],"topics":["ideas"],"roles":{"A":{"archetypes":["visionary","playful"]},"B":{"archetypes":["dry-wit","veteran"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if the café had a menu of conversations?"},
      {"role":"B","text":"I'd order the small talk. Extra small."},
      {"role":"A","face":"smile"}
    ]},
    {"id":"hd-cafe.057","spots":["coffee_bar"],"topics":["ideas"],"roles":{"A":{"archetypes":["energetic","hustler"]},"B":{"archetypes":["calm-steady","gentle"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if we met here every time we got stuck?"},
      {"role":"B","text":"The café would never be empty."},
      {"role":"A","text":"Is that a problem?"},
      {"role":"B","text":"Not for the café."}
    ]},
    {"id":"hd-cafe.058","spots":["coffee_bar"],"topics":["debate"],"roles":{"A":{"archetypes":["hustler","energetic"]},"B":{"archetypes":["calm-steady","meticulous"]}},"pair":"tension","mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"Decide now, adjust later."},
      {"role":"B","text":"Decide once, properly."},
      {"role":"A","text":"Properly takes forever."},
      {"role":"B","text":"Properly, but quickly. Deal?"}
    ]},
    {"id":"hd-cafe.059","spots":["coffee_bar"],"topics":["debate"],"roles":{"A":{"archetypes":["playful","warm"]},"B":{"archetypes":["blunt","meticulous"]}},"pair":"tension","mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"Emojis in work chat: yes or no?"},
      {"role":"B","text":"Yes, but only the polite ones."},
      {"role":"A","text":"Which ones are polite?"},
      {"role":"B","text":"The thumbs up. Sparingly."}
    ]},
    {"id":"hd-cafe.060","spots":["coffee_bar"],"topics":["debate"],"roles":{"A":{"archetypes":["meticulous","analytical"]},"B":{"archetypes":["playful","visionary"]}},"pair":"tension","mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"Light mode. I like to see my mistakes."},
      {"role":"B","text":"Dark mode. I like to hide mine."},
      {"role":"A","text":"Call it a truce?"},
      {"role":"B","text":"A truce, in dark mode."}
    ]},
    {"id":"hd-cafe.061","spots":["coffee_bar"],"topics":["debate"],"roles":{"A":{"archetypes":["gentle","calm-steady"]},"B":{"archetypes":["energetic","hustler"]}},"pair":"tension","mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"Quiet headlines let the reader lean in."},
      {"role":"B","text":"Bold headlines make them sit up."},
      {"role":"A","text":"Medium, then?"},
      {"role":"B","text":"Medium. Everyone's comfortable."}
    ]},
    {"id":"hd-cafe.062","spots":["coffee_bar"],"topics":["debate"],"roles":{"A":{"archetypes":["visionary","playful"]},"B":{"archetypes":["meticulous","analytical"]}},"pair":"tension","mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"Sticky notes or a doc?"},
      {"role":"B","text":"Sticky notes to think. A doc to remember."},
      {"role":"A","text":"Both, then."},
      {"role":"B","text":"Both. Always both."}
    ]},
    {"id":"hd-cafe.063","spots":["coffee_bar"],"topics":["debate"],"roles":{"A":{"archetypes":["meticulous","analytical"]},"B":{"archetypes":["hustler","energetic"]}},"pair":"tension","mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"Plan everything up front."},
      {"role":"B","text":"Plan the next step and the direction."},
      {"role":"A","text":"That's barely a plan."},
      {"role":"B","text":"That's the best kind."}
    ]},
    {"id":"hd-cafe.064","spots":["coffee_bar"],"topics":["debate"],"roles":{"A":{"archetypes":["analytical","blunt"]},"B":{"archetypes":["warm","visionary"]}},"pair":"tension","mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"Numbers first, then the story."},
      {"role":"B","text":"Story first. The numbers can follow."},
      {"role":"A","text":"Numbers are a story."},
      {"role":"B","text":"Then they can go first. Fine."}
    ]},
    {"id":"hd-cafe.065","spots":["coffee_bar"],"topics":["debate"],"roles":{"A":{"archetypes":["blunt","meticulous"]},"B":{"archetypes":["visionary","playful"]}},"pair":"tension","mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"Memos beat slides."},
      {"role":"B","text":"Slides have better pictures."},
      {"role":"A","text":"Slides hide the verbs."},
      {"role":"B","text":"Put a picture in the memo, then."}
