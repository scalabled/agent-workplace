    {"id":"hd-cafe.019","spots":["coffee_bar","water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["visionary","playful"]},"B":{"archetypes":["dry-wit","analytical"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"The counter is where ideas go to warm up."},
      {"role":"B","text":"And the cooler is where they cool down."},
      {"role":"A","text":"Full thermostat, this floor."}
