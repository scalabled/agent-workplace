    {"id":"hd-cafe.003","spots":["coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["calm-steady","veteran"]},"B":{"archetypes":["dry-wit","playful"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
