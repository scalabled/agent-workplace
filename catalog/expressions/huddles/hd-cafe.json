    {"id":"hd-cafe.014","spots":["coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["warm","gentle"]},"B":{"archetypes":["dry-wit","playful"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
