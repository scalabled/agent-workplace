    {"id":"hd-cafe.067","spots":["coffee_bar"],"topics":["office"],"context":["part_of_day:late_night"],"roles":{"A":{"archetypes":["visionary","calm-steady"]},"B":{"archetypes":["warm","playful"]}},"mood":{"valence":0.0,"energy":-0.3},"lines":[
