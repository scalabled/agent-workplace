    {"id":"hd-cafe.005","spots":["coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["playful","energetic"]},"B":{"archetypes":["gentle","warm"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
