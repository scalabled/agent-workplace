    {"id":"hd-cafe.016","spots":["coffee_bar"],"topics":["office"],"roles":{"A":{"archetypes":["dry-wit","playful"]},"B":{"archetypes":["warm","calm-steady"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Does the monstera get more light than we do?"},
