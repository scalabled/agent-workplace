    {"id":"hd-cafe.022","spots":["coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["analytical","meticulous"]},"B":{"archetypes":["playful","warm"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"The machine behind the counter is very well behaved."},
      {"role":"B","text":"It's never been asked to do anything."},
