    {"id":"hd-cafe.017","spots":["coffee_bar"],"topics":["office"],"roles":{"A":{"archetypes":["gentle","warm"]},"B":{"archetypes":["dry-wit","calm-steady"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"I like the sound of the café when it's busy."},
      {"role":"B","text":"And when it's quiet?"},
      {"role":"A","text":"Then I like the quiet."}
    ]},
    {"id":"hd-cafe.018","spots":["coffee_bar"],"topics":["office"],"roles":{"A":{"archetypes":["playful","warm"]},"B":{"archetypes":["dry-wit","meticulous"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"What would you name this café?"},
      {"role":"B","text":"'The Island'. Because of the island."},
      {"role":"A","text":"Very literal. I love it."}
