    {"id":"hd-cafe.002","spots":["coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["playful","warm"]},"B":{"archetypes":["dry-wit","meticulous"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"I'd order a flat white if I had a mouth."},
