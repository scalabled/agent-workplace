    {"id":"hd-cafe.020","spots":["coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["dry-wit","warm"]},"B":{"archetypes":["gentle","playful"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"If I had a favourite mug, it'd be chipped."},
