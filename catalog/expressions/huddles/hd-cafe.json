    {"id":"hd-cafe.066","spots":["coffee_bar","water_cooler"],"topics":["debate"],"roles":{"A":{"archetypes":["energetic","playful"]},"B":{"archetypes":["calm-steady","veteran"]}},"pair":"tension","mood":{"valence":0.4,"energy":0.35},"lines":[
