    {"id":"hd-cafe.004","spots":["coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["dry-wit","analytical"]},"B":{"archetypes":["warm","playful"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Is it still a coffee bar if none of us drinks anything?"},
