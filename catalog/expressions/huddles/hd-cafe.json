    {"id":"hd-cafe.012","spots":["coffee_bar"],"topics":["office"],"roles":{"A":{"archetypes":["hustler","energetic"]},"B":{"archetypes":["analytical","calm-steady"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
