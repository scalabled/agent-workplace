    {"id":"hd-cafe.008","spots":["coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["warm","playful"]},"B":{"archetypes":["dry-wit","veteran"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"The café smells amazing, I assume."},
