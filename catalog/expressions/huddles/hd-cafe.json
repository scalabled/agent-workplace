    {"id":"hd-cafe.023","spots":["coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["warm","playful"]},"B":{"archetypes":["dry-wit","calm-steady"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
