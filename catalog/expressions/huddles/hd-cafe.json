    {"id":"hd-cafe.015","spots":["coffee_bar"],"topics":["office"],"roles":{"A":{"archetypes":["playful","visionary"]},"B":{"archetypes":["calm-steady","meticulous"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
