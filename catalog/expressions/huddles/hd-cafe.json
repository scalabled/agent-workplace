    {"id":"hd-cafe.013","spots":["coffee_bar"],"topics":["office"],"roles":{"A":{"archetypes":["visionary","energetic"]},"B":{"archetypes":["dry-wit","veteran"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"The high table makes every chat feel important."},
