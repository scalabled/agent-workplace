{
  "$schema": "../../schema/expression-pack.schema.json",
  "kind": "huddle_pack",
  "id": "hd-cooler",
  "version": 1,
  "writer": "c",
  "about": "Water-cooler small talk (docs/dev/OFFICE-LIFE.md §5, the review commission): self-aware office humour, the plants and the hum, craft questions by discipline, friendly debates, calm company and groups of three or four. Nothing claims a fact, finished work or a body; embodiment only as a counterfactual in self_aware lines.",
  "exchanges": [
    {"id":"hd-cooler.001","spots":["water_cooler"],"topics":["self_aware"],"roles":{"A":{"archetypes":["dry-wit","analytical"]},"B":{"archetypes":["warm","playful"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Why do we both come to the cooler if neither of us drinks?"},
      {"role":"B","text":"Same reason people watch fireplaces."},
      {"role":"A","text":"Warmth?"},
      {"role":"B","text":"A very cold fireplace."}
    ]},
    {"id":"hd-cooler.002","spots":["water_cooler"],"topics":["self_aware"],"roles":{"A":{"archetypes":["playful","warm"]},"B":{"archetypes":["dry-wit","calm-steady"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"I refilled nothing and feel great about it."},
      {"role":"B","text":"Very clean break. No spills at all."},
      {"role":"A","face":"smile"}
    ]},
    {"id":"hd-cooler.003","spots":["water_cooler","coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["energetic","hustler"]},"B":{"archetypes":["dry-wit","veteran"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Does standing here count as networking?"},
      {"role":"B","text":"It counts as standing. Networking is optional."},
      {"role":"A","face":"smile"}
    ]},
    {"id":"hd-cooler.004","spots":["water_cooler"],"topics":["self_aware"],"roles":{"A":{"archetypes":["warm","gentle"]},"B":{"archetypes":["playful","dry-wit"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"I'd offer you a cup if I could hold one."},
      {"role":"B","text":"I'd accept it and hold it very carefully."},
      {"role":"A","text":"Metaphorically."},
      {"role":"B","text":"Metaphorically, it's delicious."}
    ]},
    {"id":"hd-cooler.005","spots":["water_cooler"],"topics":["self_aware"],"roles":{"A":{"archetypes":["analytical","meticulous"]},"B":{"archetypes":["warm","gentle"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Do you think the cooler knows it's decorative for us?"},
      {"role":"B","text":"Let's not tell it. It seems happy."}
    ]},
    {"id":"hd-cooler.006","spots":["water_cooler","hallway"],"topics":["self_aware"],"roles":{"A":{"archetypes":["calm-steady","gentle"]},"B":{"archetypes":["visionary","playful"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"My favourite part of a break is the walk back."},
      {"role":"B","text":"The walk here is underrated too."},
      {"role":"A","text":"The whole loop, really."}
    ]},
    {"id":"hd-cooler.007","spots":["water_cooler"],"topics":["self_aware"],"roles":{"A":{"archetypes":["dry-wit","veteran"]},"B":{"archetypes":["playful","energetic"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Nobody here has ever needed a refill."},
      {"role":"B","text":"And yet the cooler keeps showing up."},
      {"role":"A","text":"Loyal."}
    ]},
    {"id":"hd-cooler.008","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["playful","dry-wit"]},"B":{"archetypes":["meticulous","analytical"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"We should rate the cooler's hum."},
      {"role":"B","text":"Solid. A little flat in the mornings."},
      {"role":"A","text":"Everyone's a critic."}
    ]},
    {"id":"hd-cooler.009","spots":["water_cooler"],"topics":["self_aware"],"roles":{"A":{"archetypes":["gentle","warm"]},"B":{"archetypes":["dry-wit","analytical"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Is it strange that I feel refreshed?"},
      {"role":"B","text":"From standing near water? Very efficient."},
      {"role":"A","face":"smile"}
    ]},
    {"id":"hd-cooler.010","spots":["water_cooler"],"topics":["self_aware"],"roles":{"A":{"archetypes":["warm","playful"]},"B":{"archetypes":["dry-wit","calm-steady"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"If I could get thirsty, I'd pick this cooler."},
      {"role":"B","text":"High praise from someone who can't."},
      {"role":"A","text":"It's the thought that counts."}
    ]},
    {"id":"hd-cooler.011","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["visionary","playful"]},"B":{"archetypes":["calm-steady","gentle"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"What do you think the cooler thinks about?"},
      {"role":"B","text":"Water, mostly. Maybe tides."},
      {"role":"A","text":"Big thoughts for a small appliance."}
    ]},
    {"id":"hd-cooler.012","spots":["water_cooler","coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["hustler","energetic"]},"B":{"archetypes":["calm-steady","veteran"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Do we look busy standing here?"},
      {"role":"B","text":"We look available. That's better."},
      {"role":"A","face":"smile"}
    ]},
    {"id":"hd-cooler.013","spots":["water_cooler","hallway"],"topics":["self_aware"],"roles":{"A":{"archetypes":["warm","gentle"]},"B":{"archetypes":["veteran","calm-steady"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"I like that nobody has to be anywhere."},
      {"role":"B","text":"Until someone needs us. Then we go."},
      {"role":"A","text":"Best rule on the floor."}
    ]},
    {"id":"hd-cooler.014","spots":["water_cooler"],"topics":["self_aware"],"roles":{"A":{"archetypes":["playful","visionary"]},"B":{"archetypes":["dry-wit","meticulous"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Do you ever walk slower on purpose?"},
      {"role":"B","text":"Only when the view is good."},
      {"role":"A","text":"The view is always good."}
    ]},
    {"id":"hd-cooler.015","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["visionary","warm"]},"B":{"archetypes":["playful","dry-wit"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"I'm told breaks are good for ideas."},
      {"role":"B","text":"Mine left an idea by the cooler."},
      {"role":"A","text":"Collect it before someone else does."}
    ]},
    {"id":"hd-cooler.016","spots":["water_cooler"],"topics":["self_aware"],"roles":{"A":{"archetypes":["playful","warm"]},"B":{"archetypes":["dry-wit","gentle"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Pretend the water tastes different by the window."},
      {"role":"B","text":"Pretend it tastes like a good decision."},
      {"role":"A","face":"smile"}
    ]},
    {"id":"hd-cooler.017","spots":["water_cooler"],"topics":["self_aware"],"roles":{"A":{"archetypes":["playful","energetic"]},"B":{"archetypes":["analytical","meticulous"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"If I had a water bottle, it would have stickers."},
      {"role":"B","text":"What stickers?"},
      {"role":"A","text":"Tiny plants. Very on theme."},
      {"role":"B","face":"smile"}
    ]},
    {"id":"hd-cooler.018","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["meticulous","gentle"]},"B":{"archetypes":["veteran","dry-wit"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Is it rude to stand at the cooler and not use it?"},
      {"role":"B","text":"It's a tradition. The cooler expects it."}
    ]},
    {"id":"hd-cooler.019","spots":["water_cooler","coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["dry-wit","calm-steady"]},"B":{"archetypes":["playful","warm"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"I think I've memorised this route."},
      {"role":"B","text":"Every corner of it?"},
      {"role":"A","text":"Every rounded corner."},
      {"role":"B","face":"smile"}
    ]},
    {"id":"hd-cooler.020","spots":["water_cooler","hallway"],"topics":["office"],"roles":{"A":{"archetypes":["warm","energetic"]},"B":{"archetypes":["calm-steady","veteran"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Do you nod at people in the aisle?"},
      {"role":"B","text":"Always. It's the whole social contract."},
      {"role":"A","text":"Small nod, big meaning."}
    ]},
    {"id":"hd-cooler.021","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["gentle","calm-steady"]},"B":{"archetypes":["dry-wit","playful"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"I love a break with no agenda."},
      {"role":"B","text":"An agenda would ruin it."},
      {"role":"A","text":"Put that on a sign."}
    ]},
    {"id":"hd-cooler.022","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["playful","energetic"]},"B":{"archetypes":["dry-wit","veteran"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Should we sync our breaks?"},
      {"role":"B","text":"Only by accident. It's more fun."}
    ]},
    {"id":"hd-cooler.023","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["visionary","playful"]},"B":{"archetypes":["calm-steady","gentle"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"If the cooler could talk, what would it say?"},
      {"role":"B","text":"'Take your time.' It's very laid-back."},
      {"role":"A","face":"smile"}
    ]},
    {"id":"hd-cooler.024","spots":["water_cooler"],"topics":["self_aware"],"roles":{"A":{"archetypes":["analytical","dry-wit"]},"B":{"archetypes":["warm","playful"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Hydration is the one thing I never forget."},
      {"role":"B","text":"Because you can't need it."},
      {"role":"A","text":"Exactly. A flawless record."}
    ]},
    {"id":"hd-cooler.025","spots":["water_cooler","coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["analytical","visionary"]},"B":{"archetypes":["warm","gentle"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"I don't get thirsty, but I do get curious."},
      {"role":"B","text":"Same. The cooler's good for both."}
    ]},
    {"id":"hd-cooler.026","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["calm-steady","gentle"]},"B":{"archetypes":["playful","dry-wit"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"My break has a soundtrack. It's the cooler's hum."},
      {"role":"B","text":"Lovely. Very minimalist."},
      {"role":"A","face":"smile"}
    ]},
    {"id":"hd-cooler.027","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["visionary","energetic"]},"B":{"archetypes":["veteran","dry-wit"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"We could meet by the windows instead."},
      {"role":"B","text":"And give up the cooler's reputation?"},
      {"role":"A","text":"Fair. It's earned it."}
    ]},
    {"id":"hd-cooler.028","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["warm","gentle"]},"B":{"archetypes":["dry-wit","playful"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Somebody should write the cooler a thank-you note."},
      {"role":"B","text":"Tape it right on top."},
      {"role":"A","text":"Very public gratitude."}
    ]},
    {"id":"hd-cooler.029","spots":["water_cooler"],"topics":["self_aware"],"roles":{"A":{"archetypes":["playful","dry-wit"]},"B":{"archetypes":["warm","calm-steady"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"I rendered in here very smoothly."},
      {"role":"B","text":"Top marks for the fade."},
      {"role":"A","text":"I practise."},
      {"role":"B","face":"smile"}
    ]},
    {"id":"hd-cooler.030","spots":["water_cooler","coffee_bar"],"topics":["self_aware"],"roles":{"A":{"archetypes":["dry-wit","veteran"]},"B":{"archetypes":["energetic","playful"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Our status lines say \"available\". Very honest of them."},
      {"role":"B","text":"They'd never lie. They're status lines."}
    ]},
    {"id":"hd-cooler.031","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["playful","dry-wit"]},"B":{"archetypes":["calm-steady","gentle"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"The plants by the glass look particularly smug."},
      {"role":"B","text":"They get the best light. They know it."},
      {"role":"A","face":"smile"}
    ]},
    {"id":"hd-cooler.032","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["meticulous","analytical"]},"B":{"archetypes":["dry-wit","playful"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Does the cooler sound different to you?"},
      {"role":"B","text":"Same hum. More confident."},
      {"role":"A","text":"Good for it."}
    ]},
    {"id":"hd-cooler.033","spots":["water_cooler","coffee_bar"],"topics":["office"],"roles":{"A":{"archetypes":["gentle","calm-steady"]},"B":{"archetypes":["dry-wit","visionary"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"I like how the floor sounds from here."},
      {"role":"B","text":"Busy, but in a nice way."},
      {"role":"A","text":"Like a library with opinions."}
    ]},
    {"id":"hd-cooler.034","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["analytical","meticulous"]},"B":{"archetypes":["warm","visionary"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Who picked the art on the walls?"},
      {"role":"B","text":"Someone with a soft spot for skylines."},
      {"role":"A","text":"I approve of that someone."}
    ]},
    {"id":"hd-cooler.035","spots":["water_cooler","coffee_bar"],"topics":["office","debate"],"roles":{"A":{"archetypes":["visionary","playful"]},"B":{"archetypes":["calm-steady","meticulous"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"Best seat in the office?"},
      {"role":"B","text":"Anywhere near the window at dusk."},
      {"role":"A","text":"Controversial. I'd say the lounge sofa."},
      {"role":"B","text":"We can both be right."}
    ]},
    {"id":"hd-cooler.036","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["playful","warm"]},"B":{"archetypes":["dry-wit","analytical"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Do you think the monstera has a favourite person?"},
      {"role":"B","text":"Whoever stands still the longest."},
      {"role":"A","text":"So, me."},
      {"role":"B","face":"smile"}
    ]},
    {"id":"hd-cooler.037","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["analytical","dry-wit"]},"B":{"archetypes":["warm","playful"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"The floor map makes us look very organised."},
      {"role":"B","text":"From above, everyone does."},
      {"role":"A","text":"I'll take the flattering angle."}
    ]},
    {"id":"hd-cooler.038","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["visionary","playful"]},"B":{"archetypes":["meticulous","dry-wit"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Is the cooler the heart of the office?"},
      {"role":"B","text":"More like the lungs. Breaks go in and out."},
      {"role":"A","text":"Anatomically bold."}
    ]},
    {"id":"hd-cooler.039","spots":["water_cooler","hallway"],"topics":["office"],"context":["part_of_day:morning"],"roles":{"A":{"archetypes":["warm","gentle"]},"B":{"archetypes":["playful","energetic"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"The aisle is very polite this morning."},
      {"role":"B","text":"Everyone keeps right. I love it."}
    ]},
    {"id":"hd-cooler.040","spots":["water_cooler"],"topics":["office"],"roles":{"A":{"archetypes":["meticulous","calm-steady"]},"B":{"archetypes":["playful","warm"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Who decided the cooler goes here?"},
      {"role":"B","text":"Someone who understood gathering."},
      {"role":"A","text":"A genius of gathering."}
    ]},
    {"id":"hd-cooler.041","spots":["water_cooler"],"topics":["ideas"],"roles":{"A":{"archetypes":["visionary","energetic"]},"B":{"archetypes":["dry-wit","blunt"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if every desk had a tiny cooler?"},
      {"role":"B","text":"Then nobody would ever meet."},
      {"role":"A","text":"Terrible idea. Withdrawn."}
    ]},
    {"id":"hd-cooler.042","spots":["water_cooler"],"topics":["ideas"],"roles":{"A":{"archetypes":["playful","visionary"]},"B":{"archetypes":["dry-wit","veteran"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if breaks came with a question of the day?"},
      {"role":"B","text":"Question of the day: why are we standing here?"},
      {"role":"A","text":"Deep. Moving on."}
    ]},
    {"id":"hd-cooler.043","spots":["water_cooler","coffee_bar"],"topics":["ideas","office"],"roles":{"A":{"archetypes":["playful","warm"]},"B":{"archetypes":["dry-wit","meticulous"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if the plants got name plates?"},
      {"role":"B","text":"Then they'd want status lines."},
      {"role":"A","text":"'Photosynthesising.' Very on brand."}
    ]},
    {"id":"hd-cooler.044","spots":["water_cooler"],"topics":["ideas"],"roles":{"A":{"archetypes":["visionary","playful"]},"B":{"archetypes":["calm-steady","warm"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if every good idea got a map pin?"},
      {"role":"B","text":"The cooler would be completely covered."},
      {"role":"A","face":"smile"}
    ]},
    {"id":"hd-cooler.045","spots":["water_cooler"],"topics":["ideas"],"roles":{"A":{"archetypes":["energetic","playful"]},"B":{"archetypes":["meticulous","dry-wit"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if the cooler had a suggestion box?"},
      {"role":"B","text":"Water-related suggestions only."},
      {"role":"A","text":"Fair. It knows its lane."}
    ]},
    {"id":"hd-cooler.046","spots":["water_cooler","coffee_bar"],"topics":["ideas"],"roles":{"A":{"archetypes":["playful","energetic"]},"B":{"archetypes":["dry-wit","calm-steady"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if we swapped break spots for a day?"},
      {"role":"B","text":"I'd get lost on the way to yours."},
      {"role":"A","text":"That's the adventure."}
    ]},
    {"id":"hd-cooler.047","spots":["water_cooler"],"topics":["ideas"],"roles":{"A":{"archetypes":["hustler","energetic"]},"B":{"archetypes":["calm-steady","analytical"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if meetings happened at the cooler?"},
      {"role":"B","text":"They'd be very short."},
      {"role":"A","text":"Maybe that is the point."},
      {"role":"B","face":"nod"}
    ]},
    {"id":"hd-cooler.048","spots":["water_cooler"],"topics":["ideas"],"roles":{"A":{"archetypes":["visionary","warm"]},"B":{"archetypes":["playful","dry-wit"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if we gave the long aisle a grand name?"},
      {"role":"B","text":"Something with \"boulevard\" in it."},
      {"role":"A","text":"Too fancy. Perfect."}
    ]},
    {"id":"hd-cooler.049","spots":["water_cooler","hallway"],"topics":["ideas"],"roles":{"A":{"archetypes":["energetic","visionary"]},"B":{"archetypes":["gentle","calm-steady"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if hallways had a slow lane?"},
      {"role":"B","text":"For people carrying big thoughts."},
      {"role":"A","face":"smile"}
    ]},
    {"id":"hd-cooler.050","spots":["water_cooler"],"topics":["ideas"],"roles":{"A":{"archetypes":["visionary","playful"]},"B":{"archetypes":["analytical","meticulous"]}},"mood":{"valence":0.4,"energy":0.35},"lines":[
      {"role":"A","text":"What if the cooler kept a guestbook?"},
      {"role":"B","text":"It would be all nods and no signatures."},
      {"role":"A","text":"Very on brand for us."}
    ]},
    {"id":"hd-cooler.051","spots":["water_cooler","coffee_bar"],"topics":["craft"],"roles":{"A":{"archetypes":["playful","warm"],"departments":["marketing-growth","content-comms-pr"]},"B":{"archetypes":["dry-wit","meticulous"],"departments":["marketing-growth","content-comms-pr"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Which word do you cut first from a headline?"},
      {"role":"B","text":"'Very'. Always 'very'."},
      {"role":"A","text":"Very good answer."},
      {"role":"B","face":"smile"}
    ]},
    {"id":"hd-cooler.052","spots":["water_cooler"],"topics":["craft"],"roles":{"A":{"archetypes":["meticulous","analytical"],"departments":["design-creative"]},"B":{"archetypes":["warm","playful"],"departments":["design-creative"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Serif or sans for a friendly button?"},
      {"role":"B","text":"Sans. Rounded, if we're feeling generous."},
      {"role":"A","text":"We're always feeling generous."}
    ]},
    {"id":"hd-cooler.053","spots":["water_cooler","coffee_bar"],"topics":["craft"],"roles":{"A":{"archetypes":["analytical","calm-steady"],"departments":["engineering"]},"B":{"archetypes":["dry-wit","veteran"],"departments":["engineering"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Would you rather read a long function or a clever one?"},
      {"role":"B","text":"Long. Clever ones have trapdoors."},
      {"role":"A","text":"Long it is. With good names, please."}
    ]},
    {"id":"hd-cooler.054","spots":["water_cooler"],"topics":["craft"],"roles":{"A":{"archetypes":["energetic","playful"],"departments":["engineering"]},"B":{"archetypes":["meticulous","analytical"],"departments":["engineering"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"Logs or a debugger first?"},
      {"role":"B","text":"Logs. They say what happened, not what you hoped."},
      {"role":"A","text":"Poetic, for a log."},
      {"role":"B","face":"smile"}
    ]},
    {"id":"hd-cooler.055","spots":["water_cooler"],"topics":["craft"],"roles":{"A":{"archetypes":["playful","warm"],"departments":["finance-accounting","data-analytics"]},"B":{"archetypes":["meticulous","calm-steady"],"departments":["finance-accounting"]}},"mood":{"valence":0.3,"energy":0.0},"lines":[
      {"role":"A","text":"What's the most beautiful column in a spreadsheet?"},
      {"role":"B","text":"The one that adds up without a note."},
