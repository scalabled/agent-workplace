          { "id": "ex-calm-steady.laugh.01", "text": "(chuckles)", "nonverbal": true, "tags": { "xai": "<soft>[laugh]</soft>", "openai": { "say": "Heh heh.", "instructions": "A soft, low chuckle." } } }
