        "celebrate": [
          { "id": "ex-energetic.celebrate.01", "text": "Yes! That's the one!", "tags": { "xai": "[sharp-breath] Yes! That's the one!" }, "mood": { "valence": 0.8, "energy": 0.8 } }
        ]
      }
    },
    {
