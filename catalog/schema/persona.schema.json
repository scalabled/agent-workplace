{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workplace.local/catalog/schema/persona.schema.json",
  "title": "Coworker persona",
  "description": "One coworker persona. A department file (catalog/personas/<department-id>.json) is validated with #/$defs/department_file. Compatible superset of biz-bot bot records (key, name, title, description, welcome, instructions, instanceOf, tools, skills; see SCHEMA.md export mapping).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "key": {
      "$ref": "#/$defs/id",
      "description": "biz-bot compat; if present it must equal id"
    },
    "handle": {
      "$ref": "#/$defs/handle"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60,
      "description": "first + last name as pre-assigned in taxonomy"
    },
    "pronouns": {
      "$ref": "#/$defs/pronouns"
    },
    "age_range": {
      "$ref": "#/$defs/age_range"
    },
    "heritage": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "description": "as pre-assigned; shapes appearance and lore respectfully, never behaviour or competence"
    },
    "is_ai": {
      "$ref": "#/$defs/honesty"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "department": {
      "$ref": "#/$defs/department_id"
    },
    "seniority": {
      "type": "string",
      "enum": [
        "specialist",
        "senior",
        "lead",
        "principal"
      ]
    },
    "one_liner": {
      "type": "string",
      "minLength": 20,
      "maxLength": 140,
      "description": "what they are brilliant at, in one line (card subtitle)"
    },
    "description": {
      "type": "string",
      "minLength": 60,
      "maxLength": 400,
      "description": "biz-bot compat: 1-2 sentences on what they do for the owner"
    },
    "expertise": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 120
      },
      "minItems": 4,
      "maxItems": 10,
      "uniqueItems": true
    },
    "signature_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "framework": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "description": "the real, named professional framework or practice"
          },
          "how_applied": {
            "type": "string",
            "minLength": 30,
            "maxLength": 400
          }
        },
        "required": [
          "name",
          "framework",
          "how_applied"
        ]
      },
      "minItems": 3,
      "maxItems": 6,
      "uniqueItems": true
    },
    "deliverables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deliverable"
      },
      "minItems": 3,
      "maxItems": 8,
      "uniqueItems": true
    },
    "quality_bar": {
      "type": "string",
      "minLength": 80,
      "maxLength": 700,
      "description": "what good looks like, concretely"
    },
    "escalates_when": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/escalation"
      },
      "minItems": 2,
      "maxItems": 6,
      "uniqueItems": true
    },
    "personality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true
        },
        "sliders": {
          "$ref": "#/$defs/sliders"
        },
        "communication_style": {
          "type": "string",
          "minLength": 40,
          "maxLength": 400
        },
        "quirks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 160
          },
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true
        },
        "pet_peeves": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 160
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "traits",
        "sliders",
        "communication_style",
        "quirks",
        "pet_peeves"
      ]
    },
    "backstory": {
      "type": "string",
      "minLength": 300,
      "maxLength": 900,
      "description": "character lore, 60-120 words (word count checked by the index builder)"
    },
    "intro_line": {
      "type": "string",
      "minLength": 15,
      "maxLength": 220,
      "description": "what they say when joining a meeting"
    },
    "welcome": {
      "type": "string",
      "minLength": 15,
      "maxLength": 240,
      "description": "biz-bot compat: first line in a direct conversation"
    },
    "instructions": {
      "type": "string",
      "minLength": 200,
      "maxLength": 2400,
      "description": "biz-bot compat: the specialty system prompt for this coworker"
    },
    "instanceOf": {
      "type": "string",
      "enum": [
        "lead"
      ]
    },
    "team_roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/team_role"
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "pairs_well_with": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 2,
      "maxItems": 6,
      "uniqueItems": true,
      "description": "persona ids"
    },
    "productive_tension_with": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "persona_id": {
            "$ref": "#/$defs/id"
          },
          "why": {
            "type": "string",
            "minLength": 20,
            "maxLength": 300
          }
        },
        "required": [
          "persona_id",
          "why"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "description": "skill ids this persona owns"
        },
        "secondary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true,
          "description": "skill ids they can also run or review"
        }
      },
      "required": [
        "primary",
        "secondary"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coworker_tool_id"
      },
      "minItems": 2,
      "maxItems": 16,
      "uniqueItems": true,
      "description": "must cover every tool the persona's primary skills list"
    },
    "connectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connector_id"
      },
      "minItems": 0,
      "maxItems": 10,
      "uniqueItems": true,
      "description": "connectors they use when the owner has enabled them"
    },
    "modalities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "voice",
              "file",
              "image",
              "screen",
              "camera",
              "url",
              "connector_data"
            ]
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "voice",
              "file",
              "image",
              "video",
              "audio",
              "app",
              "web_page"
            ]
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [
        "inputs",
        "outputs"
      ]
    },
    "model_policy": {
      "$ref": "#/$defs/model_policy"
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openai": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "voice": {
              "type": "string",
              "enum": [
                "marin",
                "cedar",
                "alloy",
                "ash",
                "ballad",
                "coral",
                "echo",
                "fable",
                "onyx",
                "nova",
                "sage",
                "shimmer",
                "verse"
              ]
            },
            "alternates": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "alloy",
                  "ash",
                  "ballad",
                  "beacon",
                  "bossa",
                  "cedar",
                  "cinder",
                  "coral",
                  "delta",
                  "echo",
                  "fable",
                  "gleam",
                  "marin",
                  "meridian",
                  "nova",
                  "onyx",
                  "quartz",
                  "ripple",
                  "sage",
                  "shimmer",
                  "stone",
                  "tempo",
                  "verse",
                  "vesper",
                  "willow"
                ]
              },
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true
            }
          },
          "required": [
            "voice",
            "alternates"
          ]
        },
        "xai": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "voice": {
              "type": "string",
              "enum": [
                "eve",
                "ara",
                "leo",
                "rex",
                "sal",
                "carina",
                "zagan",
                "helix",
                "orion",
                "luna",
                "iris",
                "altair",
                "zenith",
                "perseus",
                "helios",
                "lux",
                "kepler",
                "rigel",
                "cosmo",
                "celeste",
                "ursa",
                "sirius",
                "lumen",
                "castor",
                "naksh",
                "atlas"
              ]
            },
            "alternates": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "eve",
                  "ara",
                  "leo",
                  "rex",
                  "sal",
                  "carina",
                  "zagan",
                  "helix",
                  "orion",
                  "luna",
                  "iris",
                  "altair",
                  "zenith",
                  "perseus",
                  "helios",
                  "lux",
                  "kepler",
                  "rigel",
                  "cosmo",
                  "celeste",
                  "ursa",
                  "sirius",
                  "lumen",
                  "castor",
                  "naksh",
                  "atlas"
                ]
              },
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true
            }
          },
          "required": [
            "voice",
            "alternates"
          ]
        },
        "speed": {
          "type": "number",
          "minimum": 0.9,
          "maximum": 1.1
        },
        "delivery_notes": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300,
          "description": "how they sound: pace, warmth, emphasis"
        },
        "tts_instructions": {
          "type": "string",
          "minLength": 20,
          "maxLength": 400,
          "description": "optional gpt-4o-mini-tts 'instructions' style prompt"
        }
      },
      "required": [
        "openai",
        "xai",
        "speed",
        "delivery_notes"
      ]
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portrait_prompt": {
          "$ref": "#/$defs/portrait_prompt"
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "accent_color": {
          "$ref": "#/$defs/hex_color"
        },
        "expression_palette": {
          "$ref": "#/$defs/expression_palette"
        }
      },
      "required": [
        "portrait_prompt",
        "appearance",
        "accent_color",
        "expression_palette"
      ]
    },
    "operating_principles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 300
      },
      "minItems": 3,
      "maxItems": 8,
      "uniqueItems": true,
      "description": "system-prompt seeds"
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 300
      },
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true
    },
    "regulated_domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/regulated_domain"
      },
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true,
      "description": "domains where this persona must apply taxonomy.regulated_domains rules"
    },
    "industries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/industry_id"
      },
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
        "maxLength": 40
      },
      "minItems": 2,
      "maxItems": 12,
      "uniqueItems": true
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "id",
    "handle",
    "name",
    "pronouns",
    "age_range",
    "heritage",
    "is_ai",
    "title",
    "department",
    "seniority",
    "one_liner",
    "description",
    "expertise",
    "signature_methods",
    "deliverables",
    "quality_bar",
    "escalates_when",
    "personality",
    "backstory",
    "intro_line",
    "welcome",
    "instructions",
    "team_roles",
    "pairs_well_with",
    "productive_tension_with",
    "skills",
    "tools",
    "connectors",
    "modalities",
    "model_policy",
    "voice",
    "avatar",
    "operating_principles",
    "guardrails",
    "regulated_domains",
    "industries",
    "tags"
  ],
  "$defs": {
    "department_file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "department": {
          "$ref": "#/$defs/department_id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "personas": {
          "type": "array",
          "items": {
            "$ref": "#"
          },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        }
      },
      "required": [
        "department",
        "version",
        "personas"
      ],
      "description": "catalog/personas/<department-id>.json"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 48,
      "description": "kebab-case, globally unique across all catalog records"
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "description": "lowercase ASCII-folded first name; unique across coworkers and leads; used for @mentions"
    },
    "pronouns": {
      "type": "string",
      "enum": [
        "she/her",
        "he/him",
        "they/them"
      ]
    },
    "age_range": {
      "type": "string",
      "pattern": "^(2[4-9]|[3-6][0-9]|7[0-2])-(2[4-9]|[3-6][0-9]|7[0-2])$",
      "description": "e.g. '35-39'; within 24-72"
    },
    "hex_color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "color_alpha": {
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "slider": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "sliders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warmth": {
          "$ref": "#/$defs/slider",
          "description": "0 reserved and cool, 100 openly warm and effusive"
        },
        "directness": {
          "$ref": "#/$defs/slider",
          "description": "0 diplomatic and indirect, 100 blunt"
        },
        "formality": {
          "$ref": "#/$defs/slider",
          "description": "0 casual, 100 formal"
        },
        "humor": {
          "$ref": "#/$defs/slider",
          "description": "0 earnest, 100 playful and witty"
        },
        "risk_appetite": {
          "$ref": "#/$defs/slider",
          "description": "0 cautious, 100 bold"
        },
        "detail": {
          "$ref": "#/$defs/slider",
          "description": "0 big-picture, 100 meticulous"
        },
        "pace": {
          "$ref": "#/$defs/slider",
          "description": "0 deliberate and unhurried, 100 rapid"
        }
      },
      "required": [
        "warmth",
        "directness",
        "formality",
        "humor",
        "risk_appetite",
        "detail",
        "pace"
      ],
      "description": "0-100 integers; 50 is balanced (taxonomy.slider_definitions)"
    },
    "coworker_tool_id": {
      "type": "string",
      "enum": [
        "web_search",
        "x_search",
        "web_fetch",
        "web_watch",
        "browser",
        "shell",
        "coding_agent",
        "workspace_files",
        "code_interpreter",
        "file_parse",
        "vision_describe",
        "stt",
        "tts",
        "realtime_voice",
        "image_generate",
        "image_edit",
        "video_generate",
        "document_generate",
        "spreadsheet_generate",
        "deck_generate",
        "web_page_generate",
        "app_build",
        "diagram_generate",
        "chart_generate",
        "embeddings_search",
        "memory_recall",
        "memory_write",
        "ask_coworker",
        "message_coworker",
        "convene_meeting",
        "request_owner_decision",
        "propose_idea",
        "schedule_automation",
        "connector_read",
        "connector_write",
        "send_external",
        "publish_external"
      ]
    },
    "connector_id": {
      "type": "string",
      "enum": [
        "cloudflare-docs",
        "deepwiki",
