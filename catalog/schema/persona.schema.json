      ]
    },
    "team_role": {
      "type": "string",
      "enum": [
        "lead",
        "co_owner",
        "reviewer",
        "sceptic",
        "facilitator",
        "specialist"
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "anthropic",
        "openai",
        "xai",
        "ollama",
        "local-openai",
        "claude-cli",
        "codex-cli",
        "cloudflare",
        "mock"
      ]
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/artifact_type"
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "format": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "file format(s), e.g. 'xlsx', 'md -> docx'"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        }
      },
      "required": [
        "artifact_type",
        "name",
        "format"
      ]
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "deep",
            "balanced",
            "fast"
          ]
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vision",
              "long_context",
              "tools",
              "reasoning",
              "web_search",
              "x_search",
              "code_execution",
              "json_schema",
              "low_latency",
              "coding_agent",
              "multi_agent",
              "image_generation",
              "video_generation",
              "realtime_voice",
              "tts",
              "stt",
              "embeddings",
              "local_private"
            ]
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "provider_preference": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provider"
          },
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true,
          "description": "ordered; empty = router default"
        },
        "reasoning_effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "tier",
        "needs",
        "provider_preference"
      ],
      "description": "Names a tier and needs, never a model id (taxonomy.model_tiers)"
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "string",
          "minLength": 10,
          "maxLength": 240
        },
        "to": {
          "type": "string",
          "enum": [
            "lead",
            "owner",
            "licensed_professional",
            "coworker"
          ]
        }
      },
      "required": [
        "when",
        "to"
      ]
    },
    "honesty": {
      "const": true,
      "description": "Always true: this persona is an AI (taxonomy.honesty_policy)"
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skin_tone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "complexion_details": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true
        },
        "hair": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120
            },
            "texture": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60
            },
            "color": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60
            }
          },
          "required": [
            "style",
            "color"
          ]
        },
        "head_covering": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "facial_hair": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120,
          "description": "must keep the lips fully visible"
        },
        "eyewear": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120,
          "description": "clear lenses only"
        },
        "accessories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true
        },
        "attire": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "alt_text": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300,
          "description": "one-sentence accessible description of the portrait"
        },
        "procedural": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "avatar": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "eyeColor": {
              "$ref": "#/$defs/hex_color"
            },
            "eyeSpacing": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "eyeWidth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "eyeBrowColor": {
              "$ref": "#/$defs/hex_color"
            },
            "eyeBrowSize": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "eyeLidColor": {
              "$ref": "#/$defs/hex_color"
            },
            "eyeOutlineColor": {
              "$ref": "#/$defs/hex_color"
            },
            "mouthSize": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mouthWidth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mouthHeight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "noseSize": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "noseWidth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "noseHeight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "lipColor": {
              "$ref": "#/$defs/color_alpha"
            },
            "lipSize": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "skinHue": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "skinBrightness": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "skinGrayScale": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "showHair": {
              "type": "boolean"
            },
            "showNose": {
              "type": "boolean"
            },
            "showOutline": {
              "type": "boolean"
            }
          },
          "required": [
            "avatar",
            "eyeColor",
            "eyeSpacing",
            "eyeWidth",
            "eyeBrowColor",
            "eyeBrowSize",
            "eyeLidColor",
            "eyeOutlineColor",
            "mouthSize",
            "mouthWidth",
            "mouthHeight",
            "noseSize",
            "noseWidth",
            "noseHeight",
            "lipColor",
            "lipSize",
            "skinHue",
            "skinBrightness",
            "skinGrayScale"
          ],
          "description": "oncloudnine PersonaSettings look fields for the CSS-bust fallback (taxonomy.appearance_fields.procedural). Never 0 for size/brightness fields."
        }
      },
      "required": [
        "skin_tone",
        "hair",
        "head_covering",
        "facial_hair",
        "eyewear",
        "accessories",
        "attire",
        "alt_text",
        "procedural"
      ],
      "description": "Descriptive fields drive prompts and alt text; procedural drives the fallback bust"
    },
    "portrait_prompt": {
      "type": "string",
      "minLength": 200,
      "maxLength": 1600,
      "pattern": "^A single adult, front-facing portrait, unobstructed face, relaxed closed lips, head and shoulders, natural facial proportions, no text\\. ",
      "description": "Full generator prompt: starts with taxonomy.portrait_conventions.prompt_prefix verbatim, then follows prompt_order"
    },
    "expression_palette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resting": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "description": "the approved portrait: calm, attentive, lips closed"
        },
        "thinking": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "description": "edit instruction relative to resting (image_edit with edit_prefix)"
        },
        "delighted": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "description": "edit instruction; closed-lip smile keeps the warp valid"
        },
        "concerned": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "description": "edit instruction relative to resting"
        }
      },
      "required": [
        "resting",
        "thinking",
        "delighted",
        "concerned"
      ],
      "description": "Short edit instructions per expression state (taxonomy.portrait_conventions.expression_palette_generation)"
    }
  }
}
