        "knowledge-memory",
        "commerce-retail",
        "industry-workflows"
      ]
    },
    "department_id": {
      "type": "string",
      "enum": [
        "strategy-leadership",
        "marketing-growth",
        "sales-partnerships",
        "customer-success-support",
        "operations-supply-chain",
        "finance-accounting",
        "legal-compliance",
        "people-culture",
        "product",
        "engineering",
        "data-analytics",
        "design-creative",
        "content-comms-pr",
        "research-insights",
        "it-security-automation",
        "ecommerce-retail",
        "core-crew",
        "industry-specialists"
      ]
    },
    "regulated_domain": {
      "type": "string",
      "enum": [
        "legal",
        "tax_accounting",
        "medical_clinical",
        "investment_financial_advice",
        "employment_law",
        "security",
        "privacy"
      ]
    },
    "cost_class": {
      "type": "string",
      "enum": [
        "low",
        "med",
        "high"
      ]
    },
    "approval_tier": {
      "type": "string",
      "enum": [
        "inert",
        "draft",
        "ask",
        "always_ask"
      ]
    },
    "modality": {
      "type": "string",
      "enum": [
        "text",
        "voice",
        "file",
        "image",
        "screen",
        "camera",
        "url",
        "connector_data",
        "video",
        "audio",
        "app",
        "web_page"
      ]
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/artifact_type"
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "format": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "file format(s), e.g. 'xlsx', 'md -> docx'"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        }
      },
      "required": [
        "artifact_type",
        "name",
        "format"
      ]
    }
  }
}
