{
  "name": "@headcount/catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed loader for catalog/ (read-only). Generated bundles: full (worker) and slim (web).",
  "exports": {
    ".": "./src/index.ts",
    "./full": "./src/full.ts",
    "./slim": "./src/slim.ts"
  },
  "scripts": {
    "build": "node scripts/build-catalog.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@headcount/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
