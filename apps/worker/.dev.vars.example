# Headcount worker secrets and local settings.
# Copy to apps/worker/.dev.vars (git-ignored) and fill in what you have. Every key is optional:
# without keys the app runs on the Mock provider (and local Ollama when it is running).
# Keys stay server-side: they are never sent to the browser and never logged.

# Anthropic (chat).
ANTHROPIC_API_KEY=
# OpenAI (chat, TTS, STT, images, embeddings).
OPENAI_API_KEY=
# xAI (chat, TTS with timestamps, STT, portraits via grok-imagine).
XAI_API_KEY=
# Google Gemini (chat, embeddings).
GEMINI_API_KEY=

# Any OpenAI-compatible endpoint (LM Studio, vLLM, a hosted gateway). The key is optional for local servers.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=            # default: the first model the endpoint lists
# OPENAI_COMPATIBLE_EMBED_MODEL=      # default: the first listed model with "embed" in its id

# Optional base URL overrides (gateways, proxies). Defaults are the providers' public APIs.
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# XAI_BASE_URL=
# GEMINI_BASE_URL=

# Local Ollama. Chat uses qwen3:32b (tools), embeddings use nomic-embed-text.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=qwen3:32b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Keyless deterministic provider for tests and demos. Keep "true" locally.
ENABLE_MOCK=true
# Chat provider: "auto" (first configured of anthropic, openai, xai, gemini, openai-compatible, ollama, mock)
# or one id: anthropic | openai | xai | gemini | openai-compatible | ollama | mock.
DEFAULT_CHAT=auto
# Delay between mock stream chunks in ms (0 = instant). Above 0 it also paces Mock job checkpoints (2.5 s)
# so steering can be demoed.
# MOCK_DELAY_MS=15
# "true" makes Mock TTS/STT answer (silent audio, a fixed transcript) instead of 503 naming the keys. Demos only.
# MOCK_MEDIA=false

# Paid portrait generations allowed per UTC day (pnpm portraits:generate and "Generate portrait").
# PORTRAIT_DAILY_LIMIT=200

# Spending limits per UTC day (a runaway loop cannot spend without bound). Past a limit the route answers 429
# with a sentence naming the variable.
# TTS_DAILY_LIMIT=3000     # spoken sentences
# STT_DAILY_LIMIT=600      # recordings transcribed
# CHAT_DAILY_LIMIT=1500    # Chief of Staff turns
# JOB_DAILY_LIMIT=60       # background jobs started
# MAX_ACTIVE_JOBS=3        # background jobs running at once

# Only the app's own pages may call the API (403 otherwise). pnpm dev sets this to its web and worker ports; to open
# the app from another address (a LAN IP), start it with HEADCOUNT_ALLOWED_ORIGINS=http://192.168.1.20:5173 pnpm dev.
