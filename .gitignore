# dependencies & builds
node_modules/
dist/
.wrangler/
coverage/
test-results/
playwright-report/
*.tsbuildinfo
vite.config.ts.timestamp-*

# generated catalog bundles (rebuilt by postinstall, pnpm dev, test and typecheck)
packages/catalog/generated/

# secrets — keys live only in apps/worker/.dev.vars (see .dev.vars.example)
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# reference projects are read-only source material (and contain their own secrets)
reference/

# OS / editor
.DS_Store
*.local
.claude/*.lock

# intermediate review crops (keep final screenshots only)
docs/dev/screens/**/review/
